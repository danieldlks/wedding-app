{
  "name": "wedding-rsvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "concurrently -n functions,vite -c blue,green \"wrangler pages dev dist --port 8788\" \"vite\"",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 execute wedding-rsvp --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute wedding-rsvp --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.0",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
